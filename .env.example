# LLM API Configuration
# Provider: 'azure' for Azure OpenAI or 'local' for local LLM with OpenAI API spec
LLM_PROVIDER=azure

# Azure OpenAI Configuration
# Get your API key and endpoint from Azure Portal
LLM_API_KEY=your-azure-api-key-here
LLM_BASE_URL=https://your-resource-name.openai.azure.com/
LLM_API_VERSION=2024-02-15-preview

# Local LLM Configuration (alternative to Azure)
# For local LLM endpoints compatible with OpenAI API spec (e.g., LM Studio, LocalAI, vLLM)
# LLM_PROVIDER=local
# LLM_API_KEY=your-api-key-or-dummy
# LLM_BASE_URL=http://localhost:1234/v1
